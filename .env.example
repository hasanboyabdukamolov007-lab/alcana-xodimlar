# --- Database (required on Vercel production) ---
# Free Turso DB: https://turso.tech → create DB → copy URL + token
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=

# Local npm run dev uses file:./data/alcana.db when TURSO_DATABASE_URL is unset.

# --- Auth (protect write APIs) ---
# Same token as the Telegram bot (validates Mini App initData)
BOT_TOKEN=

# Optional fallback for scripts / admin tools (send as X-Admin-Token header)
ADMIN_API_TOKEN=

# --- Optional file storage ---
# If unset, files are stored as base64 in the DB (fine for small docs; ~3.5MB limit)
# Vercel Blob: vercel blob create / project token
BLOB_READ_WRITE_TOKEN=

# --- Bot (bot/.env — separate from Vercel) ---
# BOT_TOKEN=...
# WEBAPP_URL=https://alcana-xodimlar.vercel.app
