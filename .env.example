# --- Database (required on Vercel production) ---
# Free Turso DB: https://turso.tech → create DB → copy URL + token
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=

# Local npm run dev uses file:./data/alcana.db when TURSO_DATABASE_URL is unset.

# --- Auth (protect write APIs) ---
# REQUIRED on Vercel for Mini App «Telegramga saqlash» and initData auth.
# Same BotFather token as the local bot (e.g. @alcanastaffdata_bot).
# Vercel → Project Settings → Environment Variables → BOT_TOKEN → Redeploy.
# Setting it only in bot/.env does NOT configure the Mini App API.
BOT_TOKEN=

# Optional fallback for scripts/admin (`X-Admin-Token` header)
# Bot /add and /delete also use this value from bot/.env
ADMIN_API_TOKEN=

# --- Optional file storage ---
# If unset, files are stored as base64 in the DB (fine for small docs; ~3.5MB limit)
# Vercel Blob: vercel blob create / project token
BLOB_READ_WRITE_TOKEN=

# --- Bot (bot/.env — separate from Vercel) ---
# BOT_TOKEN=...
# WEBAPP_URL=https://alcana-xodimlar.vercel.app
# API_BASE_URL=https://alcana-xodimlar.vercel.app
# ADMIN_TELEGRAM_IDS=123456789,987654321
# ADMIN_API_TOKEN=
