BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBAPP_URL=https://alcana-xodimlar.vercel.app
# Same as Vercel Mini App origin (API base). Defaults to WEBAPP_URL.
API_BASE_URL=https://alcana-xodimlar.vercel.app

# Comma-separated Telegram user IDs allowed to run admin bot commands
# (/admin, /list, /add, /docs, /delete, /photo, /upload).
# Discover IDs with /whoami in the bot chat.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Same as Vercel ADMIN_API_TOKEN — required for bot write actions (/add, /delete)
ADMIN_API_TOKEN=
